# Copy this file to .env for local development.
# In Vercel: Project Settings -> Environment Variables -> add these same keys.
#
# The anon/publishable key is safe to expose to the browser (that's what it's
# designed for) and is prefixed with VITE_ so Vite inlines it at build time.
# The service role key is a secret and must NEVER be prefixed with VITE_.

SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: auto-provision the admin (Acquisition Editor) account on first
# visit to /login. Leave ADMIN_SEED_PASSWORD unset to disable this and
# create your admin user manually in the Supabase Dashboard instead.
ADMIN_SEED_EMAIL="fashipeakorede4@gmail.com"
ADMIN_SEED_PASSWORD="rede1234"
